#include "ipq9574.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	aliases {
		serial0 = &blsp1_uart2;
		ethernet0 = &avm_mac_addr_maceth_0;
		ethernet1 = &avm_mac_addr_maceth_1;
		ethernet2 = &avm_mac_addr_maceth_2;
		ethernet3 = &avm_mac_addr_maceth_3;
		ethernet4 = &avm_mac_addr_maceth_4;
		led-boot = &led_power;
		led-failsafe = &led_info_red;
		led-running = &led_power;
		led-upgrade = &led_info_green;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x80000000>;
	};

	reserved-memory {
		m3-dump@4d600000 {
			reg = <0x0 0x4d600000 0x0 0x100000>;
			no-map;
		};

		q6-etr@4d700000 {
			reg = <0x0 0x4d700000 0x0 0x100000>;
			no-map;
		};

		caldb@4d800000 {
			reg = <0x0 0x4d800000 0x0 0x500000>;
			no-map;
		};

		wlan-pcie0@4dd00000 {
			reg = <0x0 0x4dd00000 0x0 0x3200000>;
			no-map;
		};

		wlan-pcie2@50f00000 {
			reg = <0x0 0x50f00000 0x0 0x3200000>;
			no-map;
		};

		ramoops@60000000 {
			compatible = "ramoops";
			reg = <0x0 0x60000000 0x0 0x100000>;
			record-size = <0x40000>;
			console-size = <0x40000>;
			pmsg-size = <0x40000>;
		};

		tz-log@60100000 {
			reg = <0x0 0x60100000 0x0 0x100000>;
			no-map;
		};
	};

	usb_power: regulator-usb-power {
		compatible = "regulator-fixed";
		regulator-name = "usb-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&tlmm 12 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&keys_pins>;
		pinctrl-names = "default";

		wlan_button: wlan {
			label = "WLAN";
			linux,code = <KEY_WLAN>;
			gpios = <&tlmm 40 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		connect {
			label = "Connect";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&tlmm 64 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power: led-power {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&tlmm 26 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		led-wlan {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN;
			gpios = <&tlmm 61 GPIO_ACTIVE_HIGH>;
		};

		led-phone {
			color = <LED_COLOR_ID_GREEN>;
			function = "phone";
			gpios = <&tlmm 62 GPIO_ACTIVE_HIGH>;
		};

		led-connect {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WPS;
			gpios = <&tlmm 25 GPIO_ACTIVE_HIGH>;
		};

		led_info_green: led-info-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_INDICATOR;
			gpios = <&tlmm 27 GPIO_ACTIVE_HIGH>;
		};

		led_info_red: led-info-red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_INDICATOR;
			gpios = <&tlmm 63 GPIO_ACTIVE_HIGH>;
		};
	};

	led-dimmer {
		compatible = "pwm-leds";

		led_dim: led {
			function = LED_FUNCTION_BACKLIGHT;
			pwms = <&pwm 3 1000000 0>;
			max-brightness = <255>;
			default-state = "on";
		};
	};
};

&blsp1_uart2 {
	pinctrl-0 = <&uart2_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&rpm_requests {
	regulators {
		compatible = "qcom,rpm-mp5496-regulators";

		ipq9574_s1: s1 {
			regulator-min-microvolt = <725000>;
			regulator-max-microvolt = <1075000>;
		};
	};
};

&sdhc_1 {
	bus-width = <8>;
	max-frequency = <384000000>;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	non-removable;
	pinctrl-0 = <&sdc_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&mdio {
	pinctrl-0 = <&mdio_pins>;
	pinctrl-names = "default";
	status = "okay";

	ethernet-phy-package@0 {
		compatible = "qcom,qca8075-package";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0>;
		qcom,package-mode = "psgmii";

		phy_lan1: ethernet-phy@0 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <0>;
		};

		phy_lan2: ethernet-phy@1 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <1>;
		};

		phy_lan3: ethernet-phy@2 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <2>;
		};

		phy_lan4: ethernet-phy@3 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <3>;
		};
	};

	phy_wan: ethernet-phy@1c {
		compatible = "ethernet-phy-id004d.d101";
		reg = <28>;
		reset-gpios = <&tlmm 15 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <10000>;
	};
};

&pcie0 {
	perst-gpios = <&tlmm 23 GPIO_ACTIVE_LOW>;
	status = "okay";

	pcie@0 {
		device_type = "pci";
		reg = <0 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		avm_mac_addr_macwifi_1: wifi@0 {
			compatible = "pci17cb,1109";
			reg = <0 0 0 0 0>;
			mac-address = [00 00 00 00 00 00];
			avm,mac-name = "macwifi_1";
			avm,mac-type = <3>;
		};
	};
};

&pcie0_phy {
	status = "okay";
};

&pcie1 {
	pinctrl-0 = <&dsl_reset_pins>;
	pinctrl-names = "default";
	perst-gpios = <&tlmm 31 GPIO_ACTIVE_LOW>;
	status = "okay";

	pcie@0 {
		device_type = "pci";
		reg = <0 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		avm_mac_addr_maca: dsl@0 {
			reg = <0 0 0 0 0>;
			mac-address = [00 00 00 00 00 00];
			avm,mac-name = "maca";
		};
	};
};

&pcie1_phy {
	status = "okay";
};

&pcie2 {
	perst-gpios = <&tlmm 29 GPIO_ACTIVE_LOW>;
	status = "okay";

	pcie@0 {
		device_type = "pci";
		reg = <0 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		avm_mac_addr_macwifi_2: wifi@0 {
			compatible = "pci17cb,1109";
			reg = <0 0 0 0 0>;
			mac-address = [00 00 00 00 00 00];
			avm,mac-name = "macwifi_2";
			avm,mac-type = <3>;
		};
	};
};

&pcie2_phy {
	status = "okay";
};

&pwm {
	pinctrl-0 = <&pwm_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&usb_0_qusbphy {
	status = "okay";
};

&usb_0_qmpphy {
	status = "okay";
};

&usb3 {
	status = "okay";
};

&usb_0_dwc3 {
	dr_mode = "host";
};

&ref_48mhz_clk {
	clock-div = <1>;
	clock-mult = <2>;
};

&xo_board_clk {
	clock-div = <2>;
	clock-mult = <1>;
};

&xo_clk {
	clock-frequency = <24000000>;
};

&sleep_clk {
	clock-frequency = <32000>;
};

&tlmm {
	/* Package children do not have individual MDIO reset GPIO handling. */
	qca8075-reset {
		gpio-hog;
		gpios = <60 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "qca8075-reset-n";
	};

	keys_pins: keys-state {
		pins = "gpio40", "gpio64";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	dsl_reset_pins: dsl-reset-state {
		pins = "gpio31";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
		output-low;
	};

	pwm_pins: pwm-state {
		pins = "gpio47";
		function = "pwm";
		drive-strength = <8>;
		bias-disable;
	};

	sdc_pins: sdc-state {
		clk-pins {
			pins = "gpio5";
			function = "sdc_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cmd-pins {
			pins = "gpio4";
			function = "sdc_cmd";
			drive-strength = <8>;
			bias-pull-up;
		};

		data-pins {
			pins = "gpio0", "gpio1", "gpio2", "gpio3",
			       "gpio6", "gpio7", "gpio8", "gpio9";
			function = "sdc_data";
			drive-strength = <8>;
			bias-pull-up;
		};

		rclk-pins {
			pins = "gpio10";
			function = "sdc_rclk";
			drive-strength = <8>;
			bias-pull-down;
		};
	};
};

&qcom_ppe {
	status = "okay";

	ethernet-ports {
		#address-cells = <1>;
		#size-cells = <0>;

		avm_mac_addr_maceth_0: port@1 {
			mac-address = [00 00 00 00 00 00];
			avm,mac-name = "maceth_0";
			reg = <1>;
			phy-mode = "psgmii";
			phy-handle = <&phy_lan1>;
			pcs-handle = <&pcs0_ch0>;
			label = "lan1";
			managed = "in-band-status";

			clocks = <&nsscc NSS_CC_PORT1_MAC_CLK>,
				 <&nsscc NSS_CC_PORT1_RX_CLK>,
				 <&nsscc NSS_CC_PORT1_TX_CLK>;
			clock-names = "mac", "rx", "tx";
			resets = <&nsscc PORT1_MAC_ARES>,
				 <&nsscc PORT1_RX_ARES>,
				 <&nsscc PORT1_TX_ARES>;
			reset-names = "mac", "rx", "tx";
		};

		avm_mac_addr_maceth_1: port@2 {
			mac-address = [00 00 00 00 00 00];
			avm,mac-name = "maceth_1";
			reg = <2>;
			phy-mode = "psgmii";
			phy-handle = <&phy_lan2>;
			pcs-handle = <&pcs0_ch1>;
			label = "lan2";
			managed = "in-band-status";

			clocks = <&nsscc NSS_CC_PORT2_MAC_CLK>,
				 <&nsscc NSS_CC_PORT2_RX_CLK>,
				 <&nsscc NSS_CC_PORT2_TX_CLK>;
			clock-names = "mac", "rx", "tx";
			resets = <&nsscc PORT2_MAC_ARES>,
				 <&nsscc PORT2_RX_ARES>,
				 <&nsscc PORT2_TX_ARES>;
			reset-names = "mac", "rx", "tx";
		};

		avm_mac_addr_maceth_2: port@3 {
			mac-address = [00 00 00 00 00 00];
			avm,mac-name = "maceth_2";
			reg = <3>;
			phy-mode = "psgmii";
			phy-handle = <&phy_lan3>;
			pcs-handle = <&pcs0_ch2>;
			label = "lan3";
			managed = "in-band-status";

			clocks = <&nsscc NSS_CC_PORT3_MAC_CLK>,
				 <&nsscc NSS_CC_PORT3_RX_CLK>,
				 <&nsscc NSS_CC_PORT3_TX_CLK>;
			clock-names = "mac", "rx", "tx";
			resets = <&nsscc PORT3_MAC_ARES>,
				 <&nsscc PORT3_RX_ARES>,
				 <&nsscc PORT3_TX_ARES>;
			reset-names = "mac", "rx", "tx";
		};

		avm_mac_addr_maceth_3: port@4 {
			mac-address = [00 00 00 00 00 00];
			avm,mac-name = "maceth_3";
			reg = <4>;
			phy-mode = "psgmii";
			phy-handle = <&phy_lan4>;
			pcs-handle = <&pcs0_ch3>;
			label = "lan4";
			managed = "in-band-status";

			clocks = <&nsscc NSS_CC_PORT4_MAC_CLK>,
				 <&nsscc NSS_CC_PORT4_RX_CLK>,
				 <&nsscc NSS_CC_PORT4_TX_CLK>;
			clock-names = "mac", "rx", "tx";
			resets = <&nsscc PORT4_MAC_ARES>,
				 <&nsscc PORT4_RX_ARES>,
				 <&nsscc PORT4_TX_ARES>;
			reset-names = "mac", "rx", "tx";
		};

		avm_mac_addr_maceth_4: port@6 {
			mac-address = [00 00 00 00 00 00];
			avm,mac-name = "maceth_4";
			reg = <6>;
			phy-mode = "2500base-x";
			phy-handle = <&phy_wan>;
			pcs-handle = <&pcs2_ch0>;
			label = "wan";

			clocks = <&nsscc NSS_CC_PORT6_MAC_CLK>,
				 <&nsscc NSS_CC_PORT6_RX_CLK>,
				 <&nsscc NSS_CC_PORT6_TX_CLK>;
			clock-names = "mac", "rx", "tx";
			resets = <&nsscc PORT6_MAC_ARES>,
				 <&nsscc PORT6_RX_ARES>,
				 <&nsscc PORT6_TX_ARES>;
			reset-names = "mac", "rx", "tx";
		};
	};
};

&q6v5_wcss {
	status = "okay";
};

&soc {
	avm_mac_addr_macwifi_0: wifi@c000000 {
		mac-address = [00 00 00 00 00 00];
		avm,mac-name = "macwifi_0";
		avm,mac-type = <3>;
		qcom,bdf-addr = <0x4b700000>;
		qcom,caldb-addr = <0x4d800000>;
		status = "okay";
	};
};
