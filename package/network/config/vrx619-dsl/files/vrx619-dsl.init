#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

START=25
STOP=15
USE_PROCD=1

start_service() {
	local enabled device annex mode profiles training_timeout
	local vectoring input_swap highpass_17mhz

	config_load vrx619-dsl
	config_get_bool enabled line enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get device line device /dev/vrx619-0
	config_get annex line annex b
	config_get mode line mode vdsl
	config_get profiles line profiles 0x1ff
	config_get training_timeout line training_timeout 180
	config_get_bool vectoring line vectoring 1
	config_get_bool input_swap line input_swap 0
	config_get_bool highpass_17mhz line highpass_17mhz 0

	procd_open_instance
	procd_set_param command /usr/sbin/vrx619-dsl -d "$device" -a "$annex" \
		-m "$mode" -p "$profiles" -t "$training_timeout"
	[ "$vectoring" -eq 1 ] || procd_append_param command -v
	[ "$input_swap" -eq 0 ] || procd_append_param command -s
	[ "$highpass_17mhz" -eq 0 ] || procd_append_param command -f
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 20
	procd_set_param file /etc/config/vrx619-dsl
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger vrx619-dsl
}
